# ============================================================
# AI FACTORY SENTINEL — PER-PERSON ENV TEMPLATE
# Copy the block matching your name into a new file:
#   person1.env / person2.env / person3.env / person4.env
# Then fill in your OWN real API keys.
# NEVER commit the filled-in file — only this template is tracked.
# ============================================================

# ------------------------------------------------------------
# PERSON 1 — Nipun (8GB RAM, Any OS) — SDK Lead & Fallback Architect
# Save as: person1.env
# ------------------------------------------------------------
NVIDIA_NIM_API_KEY=nvapi-xxx
CUOPT_API_KEY=xxx
GROQ_API_KEY=gsk-xxx
NEMOCLAW_MODE=mock
SANDBOX_IMAGE=mock-wrapper
WRAPPER_IMAGE=wrapper-mock
FALLBACK_MODE=mock
DOCKER_MEMORY_LIMIT=6g
DASHBOARD_ONLY_MODE=true

# ------------------------------------------------------------
# PERSON 2 — Rashi (16GB RAM, Any OS) — Algorithms & Optimization
# Save as: person2.env
# ------------------------------------------------------------
NVIDIA_NIM_API_KEY=nvapi-xxx
CUOPT_API_KEY=xxx
GROQ_API_KEY=gsk-xxx
NEMOCLAW_MODE=mock
SANDBOX_IMAGE=mock-wrapper
WRAPPER_IMAGE=wrapper-mock
FALLBACK_MODE=mock
DOCKER_MEMORY_LIMIT=12g

# ------------------------------------------------------------
# PERSON 3 — Shreshtha (16GB RAM + RTX 4050) — Infra & NemoClaw Specialist (Demo Host)
# Save as: person3.env
# ------------------------------------------------------------
NVIDIA_NIM_API_KEY=nvapi-xxx
CUOPT_API_KEY=xxx
GROQ_API_KEY=gsk-xxx
NEMOCLAW_MODE=nemoclaw
SANDBOX_IMAGE=nemoclaw-alpha
WRAPPER_IMAGE=wrapper-nemoclaw
